# Generated example from network.example.json and allowlist.example.txt.
# Review only: enable.sh generates /run/cairn/network.nft with current host IPs.
# Generated by Cairn; apply as ONE nft transaction.
add table inet cairn_tasks
delete table inet cairn_tasks
add table bridge cairn_tasks_l2
delete table bridge cairn_tasks_l2
table inet cairn_tasks {
    set denied4 { type ipv4_addr; flags interval; elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24, 192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24, 203.0.113.0/24, 224.0.0.0/3 }; }
    set dns4 { type ipv4_addr; elements = { 1.1.1.1, 9.9.9.9 }; }
    set allowed4 { type ipv4_addr; flags interval; }
    chain denied {
        limit rate 6/minute burst 10 packets log prefix "cairn-drop " level warn
        counter drop
    }
    chain task_egress {
        meta nfproto ipv6 jump denied
        ip saddr != 172.30.0.0/24 jump denied
        ct state invalid jump denied
        ip daddr @denied4 jump denied
        ip daddr @dns4 udp dport 53 accept
        ip daddr @dns4 tcp dport 53 accept

        ip daddr @allowed4 accept
        jump denied
    }
    chain task_input {
        meta nfproto ipv6 jump denied
        ip saddr != 172.30.0.0/24 jump denied
        ct state invalid jump denied

        jump denied
    }
    chain task_ingress {
        meta nfproto ipv6 jump denied
        ct state established,related accept
        jump denied
    }
    chain forward_guard {
        type filter hook forward priority -10; policy accept;
        iifname "br-cairn" jump task_egress
        oifname "br-cairn" jump task_ingress
    }
    chain input_guard {
        type filter hook input priority -10; policy accept;
        iifname "br-cairn" jump task_input
    }
}
table bridge cairn_tasks_l2 {
    chain denied {
        limit rate 6/minute burst 10 packets log prefix "cairn-l2-drop " level warn
        counter drop
    }
    chain bridge_input {
        type filter hook input priority -200; policy accept;
        meta ibrname "br-cairn" ether type ip6 jump denied
        meta ibrname "br-cairn" ether type != { ip, arp } jump denied
    }
    chain bridge_forward {
        type filter hook forward priority -200; policy accept;
        meta ibrname "br-cairn" jump denied
        meta obrname "br-cairn" jump denied
    }
}
